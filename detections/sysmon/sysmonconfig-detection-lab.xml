<Sysmon schemaversion="4.90">
  <!--
    sysmonconfig-detection-lab.xml — a focused Sysmon baseline for the detection lab.

    Deliberately minimal: it turns on exactly the telemetry the Sigma rules in
    ../sigma depend on, so a fresh lab endpoint produces the events those rules
    match. It is NOT a production config — for that, start from Olaf Hartong's
    sysmon-modular or SwiftOnSecurity's config and tune. Cross-reference each
    block below to the rule it feeds.

    Apply:  sysmon -accepteula -i sysmonconfig-detection-lab.xml
    Update: sysmon -c sysmonconfig-detection-lab.xml
  -->
  <HashAlgorithms>SHA256</HashAlgorithms>
  <CheckRevocation>false</CheckRevocation>

  <EventFiltering>

    <!-- Event 1: ProcessCreate — feeds ntds_dump, potato_seimpersonate, wmiexec,
         rdp_hijack, scheduled_task (action), service-exec triage. Capture all;
         the Sigma rules carry the selectivity. Exclude only the noisiest signed
         updater to keep lab volume sane. -->
    <RuleGroup name="proc-create" groupRelation="or">
      <ProcessCreate onmatch="exclude">
        <Image condition="is">C:\Windows\System32\SearchIndexer.exe</Image>
      </ProcessCreate>
    </RuleGroup>

    <!-- Event 10: ProcessAccess — feeds lsass_handle_access. Captures ALL handle
         opens to LSASS (no GrantedAccess filter here on purpose: exact masks are
         brittle and vary, so collect broadly and let the lsass_handle_access Sigma
         rule apply the dump-shaped GrantedAccess masks downstream). The exclude
         group below drops the OS/AV processes that read LSASS normally. -->
    <RuleGroup name="lsass-access" groupRelation="or">
      <ProcessAccess onmatch="include">
        <TargetImage condition="image">lsass.exe</TargetImage>
      </ProcessAccess>
    </RuleGroup>
    <RuleGroup name="lsass-access-noise" groupRelation="or">
      <ProcessAccess onmatch="exclude">
        <SourceImage condition="image">MsMpEng.exe</SourceImage>
        <SourceImage condition="image">MsSense.exe</SourceImage>
        <SourceImage condition="is">C:\Windows\System32\wininit.exe</SourceImage>
        <SourceImage condition="is">C:\Windows\System32\csrss.exe</SourceImage>
      </ProcessAccess>
    </RuleGroup>

    <!-- Event 11: FileCreate — feeds mass_file_encryption_sysmon_11 (the ransomware
         encryption sweep) and corroborates the ransom-note drop.
         Why this block exists: mass_file_encryption_4663 already gets the same invariant
         from Security 4663, but only where a SACL is configured, so its reach is exactly
         the SACL's scope. Sysmon 11 sees every create/overwrite regardless of ACLs —
         that is the whole point of collecting it, and why the T1486 ingestion ticket
         asked for it.
         EXCLUDE, not include, on purpose: an encryptor writing somewhere unexpected must
         still be logged, so the default is "capture" and only the highest-rate benign
         writers are dropped. The exclusions below are by TARGET PATH wherever possible —
         excluding a whole Image (svchost, explorer) would hand an operator a place to
         write from, which is why only two purpose-built, high-churn processes are named.
         Volume warning: this is the loudest block in the file and will dominate lab event
         rate. That is the deliberate cost of ACL-independent coverage, and this is the
         first block to tighten (or scope to your document shares with an include group)
         if the lab drowns. -->
    <RuleGroup name="file-create-noise" groupRelation="or">
      <FileCreate onmatch="exclude">
        <!-- Browser + OS caches: highest write rate on any endpoint, no detection value. -->
        <TargetFilename condition="contains">\AppData\Local\Microsoft\Windows\INetCache\</TargetFilename>
        <TargetFilename condition="contains">\AppData\Local\Microsoft\Windows\WebCache\</TargetFilename>
        <TargetFilename condition="contains">\AppData\Local\Google\Chrome\User Data\Default\Cache\</TargetFilename>
        <TargetFilename condition="contains">\AppData\Local\Mozilla\Firefox\Profiles\</TargetFilename>
        <!-- OS servicing / telemetry churn. -->
        <TargetFilename condition="begin with">C:\Windows\Prefetch\</TargetFilename>
        <TargetFilename condition="begin with">C:\Windows\SoftwareDistribution\</TargetFilename>
        <TargetFilename condition="begin with">C:\Windows\WinSxS\</TargetFilename>
        <TargetFilename condition="begin with">C:\Windows\Logs\</TargetFilename>
        <TargetFilename condition="end with">.etl</TargetFilename>
        <!-- The two purpose-built indexers/scanners whose entire job is bulk file I/O.
             SearchIndexer is already excluded from ProcessCreate above for the same
             reason; MsMpEng writes definition and quarantine files continuously. -->
        <Image condition="is">C:\Windows\System32\SearchIndexer.exe</Image>
        <Image condition="image">MsMpEng.exe</Image>
      </FileCreate>
    </RuleGroup>

    <!-- Events 12/13: RegistryEvent — baseline coverage for autorun/WDigest
         persistence variants (Run keys, UseLogonCredential). Scoped to the
         high-signal keys so the lab is not flooded. -->
    <RuleGroup name="registry-autorun" groupRelation="or">
      <RegistryEvent onmatch="include">
        <TargetObject condition="contains">\CurrentVersion\Run</TargetObject>
        <TargetObject condition="contains">\SecurityProviders\WDigest\UseLogonCredential</TargetObject>
        <TargetObject condition="contains">\Image File Execution Options\</TargetObject>
      </RegistryEvent>
    </RuleGroup>

    <!-- Events 17/18: PipeEvent — an include list, so the rules only ever see the seven
         pipe names below. Which rule reads which name, and why ONE of them is read by
         nothing (#225 closed the first, #229 the next two, #248 the last two - so the only
         unread name left is unread by decision rather than by debt):

           spoolss  → spoolss_pipe_impersonation_sysmon_17. Event 17 / CreatePipe: a
                      spoolss pipe created by anything other than the spooler. Also
                      corroborates potato_seimpersonate.
           svcctl   → svcctl_atsvc_remote_pipe_sysmon_18. Event 18 / ConnectPipe with
           atsvc      Image=System, i.e. the bind came from a remote SMB client. Host-plane
                      corroboration of service_creation_psexec_7045 (7045) and
                      scheduled_task_suspicious_4698 (4698) — earlier in the chain than
                      either, and visible where those subcategories are not forwarded.
           efsrpc   → coercion_efsrpc_pipe_sysmon_18. Event 18 / ConnectPipe. Host-plane
                      corroboration of coercion_named_pipes_5145 (5145 over IPC$).
           lsarpc   → NOTHING, and deliberately so: hunt and pivot material, not a rule.
                      PipeEvent carries no authenticating principal, so filter_machine —
                      the block that makes lsarpc survivable on the 5145 plane — has no
                      counterpart here, and every coercion bind and every routine domain
                      bind arrive as the same event. It stays collected because it is worth
                      pivoting to by hand once something else fires. The argument is in
                      DEFENSE-METHODOLOGY.md.

           \pipe\srvsvc → srvsvc_epmapper_pipe_impersonation_sysmon_17. Event 17 /
           \pipe\epmapper  CreatePipe: a pipe whose name NESTS one of these endpoints, created
                      by a local process. EfsPotato stands up \<guid>\pipe\srvsvc and
                      RoguePotato \RoguePotato\pipe\epmapper, each coercing the service into
                      connecting back to it - the same ownership-on-creation shape as spoolss,
                      on two names nothing read until dotgibson/dotfiles-Defense#248. The names
                      were collected first (dotgibson/dotfiles-Defense#240) and the rule filed
                      with the collection, so the block never held an unconsumed name without a
                      tracker attached.
                      NOTE THE ENTRIES ARE \pipe\srvsvc AND \pipe\epmapper, NOT the bare
                      names, and that is the whole point. Bare `srvsvc` would also collect the
                      ROUTINE bind. Re-measured over the pinned EVTX corpus in
                      docker/validation/labruns/2026-08-srvsvc-epmapper-pipe-creation.md: of 61
                      PipeEvent records, 7 match `srvsvc` and 3 match `epmapper`. The five bare
                      \srvsvc records are all EventID 18 binds - four from Image=System, one
                      from wmiprvse.exe - arising from share enumeration, session enumeration
                      and remote named-pipe discovery; the one bare \epmapper is the legitimate
                      endpoint mapper, also an 18, also Image=System. None of the six takes the
                      nested form, so the narrow entries collect 2 apiece and drop the routine
                      traffic. If that traffic is later wanted it is a separate decision and a
                      separate rule (remote share discovery), not a widening of these lines.
                      Note the legitimate \epmapper record is Image=System, NOT svchost.exe, so
                      the Image-based filter_legit #240 proposed would not have filtered it -
                      narrowing the collection is what does that job.
                      One caveat stays open: no legitimate CREATE of either name was observed at
                      all, which is consistent with once-per-boot from rpcss and the Server
                      service but is absence of evidence - none of these captures spans a boot.
                      Volume on a live host is unmeasured, and dotgibson/dotfiles-Defense#235
                      carries it (see labruns/runbook-sysmon18-remote-pipe.md).

         Note the create/connect split above is per name, not a house style: spoolss,
         \pipe\srvsvc and \pipe\epmapper are interesting on creation, because the tool STANDS
         UP those pipes and the create is the half carrying its Image; the other names only on
         connection, because every tool in scope binds a pipe that is already there. -->
    <RuleGroup name="pipe-events" groupRelation="or">
      <PipeEvent onmatch="include">
        <PipeName condition="contains">spoolss</PipeName>
        <PipeName condition="contains">efsrpc</PipeName>
        <PipeName condition="contains">lsarpc</PipeName>
        <PipeName condition="contains">atsvc</PipeName>
        <PipeName condition="contains">svcctl</PipeName>
        <PipeName condition="contains">\pipe\srvsvc</PipeName>
        <PipeName condition="contains">\pipe\epmapper</PipeName>
      </PipeEvent>
    </RuleGroup>

    <!-- Events 19/20/21: WmiEvent — feeds wmi_event_subscription_consumer. This is
         the whole reason a Run-key/scheduled-task baseline is not enough: WMI
         subscription persistence is fileless and only shows here.
         NOTE on Sysmon semantics: an EMPTY onmatch="exclude" group excludes
         nothing, i.e. it logs ALL WmiEvent (19/20/21) — which is what we want. (An
         empty onmatch="include" would do the opposite and log none.) -->
    <RuleGroup name="wmi-events" groupRelation="or">
      <WmiEvent onmatch="exclude" />
    </RuleGroup>

  </EventFiltering>
</Sysmon>
