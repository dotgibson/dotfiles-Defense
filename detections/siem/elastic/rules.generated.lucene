(type:request AND (request.operation:(create OR update))) AND (request.path:(auth\/approle\/role\/* OR sys\/auth\/*))

// vault/vault_audit_device_disabled.yml — HashiCorp Vault audit device disabled (blind the SIEM)
type:request AND request.operation:delete AND request.path:sys\/audit\/*

