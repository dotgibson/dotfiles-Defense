# docker/detection-lab.env.example — copy to docker/.env (gitignored) and edit.
#
#   cp docker/detection-lab.env.example docker/.env
#
# docker/.env is loaded automatically by siemup/siemdown (defense.zsh passes
# --env-file). NEVER commit the real docker/.env — the .gitignore blocks it.

# OpenSearch admin password. REQUIRED and STRONG: OpenSearch 2.12+ rejects weak
# passwords (needs upper + lower + digit + special, 8+ chars). Replace the sentinel
# below with your own strong password. The sentinel is DELIBERATELY invalid (too short,
# no lowercase, no digit) so OpenSearch 2.12+ REJECTS it and the stack refuses to start
# — if you copy this file and forget to edit, the lab fails loudly instead of silently
# booting with a git-published default admin credential.
OPENSEARCH_INITIAL_ADMIN_PASSWORD=SET_ME
