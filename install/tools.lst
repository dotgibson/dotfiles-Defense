# install/tools.lst — the host-tool shopping list, and the ONE place it is written.
#
# `bootstrap.sh` reads column 1 of this file to decide what to probe, and
# install/README.md points here rather than restating the list. Before this file
# existed the set lived twice — a literal in bootstrap.sh and prose in the README —
# with nothing keeping them in step.
#
# FORMAT: one entry per line, `<command>` then an optional `# note`. Blank lines and
# comment-only lines are ignored. Column 1 is the COMMAND the probe looks for, which
# is not always the project or package name — hence the notes.
#
# This repo is distro-agnostic and installs nothing: your OS-native layer owns
# packages, and the heavy stack runs in docker/. Adding a line here adds it to the
# probe's report, nothing more.
#
# zsh leads deliberately: it is the shell this entire layer runs in, so its absence is
# categorically worse than a missing forensics tool, and bootstrap's end-of-run guard
# says so loudly.

zsh                # the shell this layer runs in — not optional
docker             # + the compose plugin; probed separately for `siemup`
jq                 # the universal log scalpel; many helpers assume it

# ── network / packet ────────────────────────────────────────────────────────────
tshark             # wireshark CLI; tcpdump is the fallback for capture
zeek               # often installs to its own prefix, /opt/zeek/bin
suricata           # IDS/IPS + EVE JSON

# ── Windows log triage ──────────────────────────────────────────────────────────
chainsaw           # WithSecureLabs — NOT kyverno/chainsaw, which shares the name
hayabusa           # Yamato-Security; ships as hayabusa-<ver>-lin-x64-gnu

# ── detection content ───────────────────────────────────────────────────────────
sigma-cli          # sigma-cli (pySigma)
yara               # yara rules engine

# ── endpoint / forensics ────────────────────────────────────────────────────────
velociraptor       # endpoint visibility / live response
vol                # volatility3; also ships as vol.py, and often lives in a venv
log2timeline.py    # plaso — the command really does carry the .py suffix
