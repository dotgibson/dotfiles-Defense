# dotfiles-Defense — paranoid .gitignore (defense-in-depth, NOT the primary control)
# Case/evidence/log data lives in ~/cases OUTSIDE this repo. This only catches
# accidents — anything that smells like investigation data, refuse to commit.

# Investigation workspaces (should never be inside the repo at all)
cases/
hunts/
evidence/
triage/

# Raw evidence & capture formats
*.pcap
*.pcapng
*.cap
*.evtx
*.evt
*.etl
*.dmp
*.mem
*.raw
*.vmem
*.aff4
*.e01
*.lime

# Logs & exported telemetry
*.log
*.jsonl
*.ndjson
*.syslog
*.winlog

# Exception: the detection-validation event fixtures are SYNTHETIC test data (checked in
# on purpose so the sigma-validation gate is reproducible), not captured case/evidence.
!docker/validation/sigma-fixtures/
!docker/validation/sigma-fixtures/*.jsonl
!docker/validation/sigma-fixtures/**/*.jsonl

# Forensic / timeline intermediates
*.plaso
*.body
*.timeline
# exported triage tables — force-add a sample if you ever need to commit one
*.csv

# Loot-adjacent: creds, tokens, keys
*.key
*.pem
*.pfx
*.kirbi
*.ccache
secrets*
creds*

# Docker / lab local state
docker/**/data/
docker/**/.env
.env

# Editor / OS noise
*.swp
.DS_Store
# Crash dumps. `core.[0-9]*` and NOT `core.*`: this repo tracks core.lock, and Core itself
# tracks core.manifest and core.version — a blanket rule would hide the next such file the
# moment someone added one, silently. Bare `core` is deliberately not matched either: that
# is the vendored Core DIRECTORY. Matches the kernel/glibc `core.<pid>` spelling.
core.[0-9]*

# Python bytecode (sigma_eval.py)
__pycache__/
*.pyc
